name: invalid_inputs_json_object
testFormat: submitfailure

files {
  workflow: invalid_inputs_json/invalid_inputs_json.wdl
  inputs: invalid_inputs_json/invalid_inputs_json_object.inputs
}

submit {
  statusCode: 400
  message: """{
  "message": "Error(s): Input file is not valid JSON. Inputs data: 'this_is_not_a_valid_json_object\n'. Error: JsonParser.ParsingException: Unexpected character 'h' at input index 0 (line 1, position 1), expected JSON Value:\nthis_is_not_a_valid_json_object\n^\n.",
  "status": "fail"
}"""
}
