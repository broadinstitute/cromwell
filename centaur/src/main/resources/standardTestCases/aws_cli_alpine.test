name: aws_cli_alpine
testFormat: workflowsuccess
backends: [ AWSBATCH ]

# basic test that a task with a non-musl based docker image can run on AWS
# with the custom aws cli mount point funkiness

files {
  workflow: docker_alpine/docker_alpine.wdl
  options: docker_alpine/docker_alpine.options
}

fileSystemCheck: "aws"
outputExpectations: {
  "/tmp/outputs/docker_alpine/<<UUID>>/call-mkdir/execution/empty_dir/.file": 1
}