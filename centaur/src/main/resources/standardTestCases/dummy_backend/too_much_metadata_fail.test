name: too_much_metadata_fail
testFormat: workflowfailure
backends: [Dummy]
tags: [Dummy]
retryTestFailures: false

# The Job Manager metadata check compares two sequential metadata pulls and would flag the shards
# that advance between them - a diff large enough to OOM the test reporter. Skip it here.
skipJobManagerMetadataValidation: true

files {
  workflow: dummy_scatter.wdl
  inputs: fail_inputs.json
}

# Produces >1.5M rows of metadata.
metadata {
  workflowName: dummy_scatter
  status: Failed
  "failures.0.message": ~~"metadata, exceeding limit of 1500000."
}
