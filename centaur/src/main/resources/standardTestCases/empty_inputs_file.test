name: empty_inputs_file
testFormat: submitfailure

files {
  workflow: invalid_inputs_json/invalid_inputs_json.wdl
  inputs: invalid_inputs_json/empty_inputs_file.inputs
}

submit {
  statusCode: 400
  message: """{
  "message": "Error(s): Input file is not valid JSON. Inputs data: ''. Error: JsonParser.ParsingException: Unexpected end-of-input at input index 0 (line 1, position 1), expected JSON Value:\n\n^\n.",
  "status": "fail"
}"""
}
