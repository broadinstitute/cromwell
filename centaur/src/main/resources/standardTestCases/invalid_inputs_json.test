name: invalid_inputs_json
testFormat: submitfailure

files {
  workflow: invalid_inputs_json/invalid_inputs_json.wdl
  inputs: invalid_inputs_json/invalid_inputs_json.inputs
}

submit {
  statusCode: 400
  message: """{
  "message": "Error(s): Input file is not valid JSON. Inputs data: '{\n  \"intentionally_missing_the_close_brace\": \"oh the humanity\"\n'. Error: JsonParser.ParsingException: Unexpected end-of-input at input index 63 (line 3, position 1), expected '}':\n\n^\n.",
  "status": "fail"
}"""
}
